#!/usr/bin/env bash
set -euo pipefail

current="$(ibus engine 2>/dev/null || true)"

case "$current" in
    Bamboo)
        # IBus can return 1 while still completing this switch; do not let that
        # make a compositor key binding appear to fail.
        ibus engine BambooUs || true
        message="English"
        ;;
    *)
        ibus engine Bamboo || true
        message="Vietnamese (Bamboo)"
        ;;
esac

notify-send -a IBus "Input method" "$message" >/dev/null 2>&1 || true
