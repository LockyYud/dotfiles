#!/usr/bin/env bash
set -euo pipefail

choice="$(printf '%s\n' Lock Suspend Logout Reboot Shutdown | vicinae dmenu --placeholder 'Power')"
case "$choice" in
  Lock) pgrep -x swaylock >/dev/null || swaylock -f ;;
  Suspend) loginctl suspend ;;
  Logout|Reboot|Shutdown)
    confirm="$(printf '%s\n' Cancel Confirm | vicinae dmenu --placeholder "Confirm $choice")"
    [ "$confirm" = Confirm ] || exit 0
    case "$choice" in
      Logout) niri msg action quit ;;
      Reboot) loginctl reboot ;;
      Shutdown) loginctl poweroff ;;
    esac
    ;;
esac
