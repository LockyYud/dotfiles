#!/bin/sh

pgrep -x sxhkd >/dev/null || sxhkd &

"$HOME/.config/bspwm/apply-display.sh" --no-polybar
pgrep -u "$USER" -f "$HOME/.config/bspwm/display-hotplug.sh" >/dev/null || "$HOME/.config/bspwm/display-hotplug.sh" &

# Host profile (if present) provides BSPWM_WALLPAPERS; falls back to no
# wallpaper change on unknown hosts rather than a hardcoded path.
HOST_PROFILE="$HOME/.config/bspwm/hosts/$(hostname).conf"
if [ -f "$HOST_PROFILE" ]; then
  . "$HOST_PROFILE"
  existing_wallpapers=""
  for wp in $BSPWM_WALLPAPERS; do
    [ -f "$wp" ] && existing_wallpapers="$existing_wallpapers $wp"
  done
  [ -n "$existing_wallpapers" ] && feh --bg-fill $existing_wallpapers &
fi

pgrep -x picom >/dev/null || picom &

$HOME/.config/polybar/launch.sh &

bspc config border_width        2
bspc config border_radius       6
bspc config window_gap          10
bspc config bottom_padding	3
bspc config top_padding		30
bspc config left_padding	3
bspc config right_padding	 3
bspc config borderless_monocle	true
bspc config single_monocle	true
bspc config gapless_monocle	false
bspc config focus_follows_pointer true
bspc config pointer_follows_focus false

bspc config pointer_modifier mod4
bspc config pointer_action1 move
bspc config pointer_action2 resize_side
bspc config pointer_action3 resize_corner
bspc config remove_disabled_monitors true
bspc config merge_overlapping_monitors true
bspc config single_monocle	false
bspc config split_ratio          0.52

bspc rule -a Gimp desktop='^8' state=floating follow=on

#Colors
bspc config normal_border_color		"transparent"
bspc config active_border_color		"#8edbd8"
bspc config focused_border_color	"#6edbd8"
bspc config presel_feedback_color	"#646695"

bspc rule -a Eww state=floating sticky=on layer=above border=off focus=on
# bspc rule -a Peek state=floating
# bspc rule -a kitty state=floating
# bspc config external_rules_command "$HOME/.config/bspwm/scripts/external-rules"
# bspc rule -a conky-manager2 state=floating
# bspc rule -a Kupfer.py focus=on
# bspc rule -a Screenkey manage=off
# bspc rule -a Plank manage=off border=off locked=on focus=off follow=off layer=above
# bspc rule -a Rofi state=floating
# bspc rule -a GLava state=floating layer=below sticky=true locked=true border=off focus=off center=true follow=off rectangle=1920x1080+0+0

xsetroot -cursor_name left_ptr
(sleep 1
  # Bật tapping và natural scrolling cho mọi thiết bị có chữ "Touchpad".
  # IFS/set -f guard device names that contain spaces (e.g. "Foo Bar Touchpad").
  old_ifs="$IFS"
  IFS='
'
  for dev in $(xinput list --name-only | grep -i 'touchpad'); do
    IFS="$old_ifs"
    xinput set-prop "$dev" "libinput Tapping Enabled" 1
    xinput set-prop "$dev" "libinput Natural Scrolling Enabled" 1
    # tuỳ chọn: giữ click-drag bằng tapping
    xinput set-prop "$dev" "libinput Tapping Drag Enabled" 1
    # tuỳ chọn: tắt left-handed nếu lỡ bật
    xinput set-prop "$dev" "libinput Left Handed Enabled" 0
    IFS='
'
  done
  IFS="$old_ifs"
) &
