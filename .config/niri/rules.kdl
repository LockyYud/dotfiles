// Keep Kitty translucent consistently, including while it has keyboard focus.
window-rule {
    match app-id="^kitty$"
    opacity 0.90
}

window-rule {
    match app-id="^pavucontrol$"
    open-floating true
}
window-rule {
    match app-id="^nm-connection-editor$"
    open-floating true
}
window-rule {
    match app-id="^blueman-manager$"
    open-floating true
}
window-rule {
    match app-id="^org.gimp.GIMP$"
    open-floating true
}
