// Verify identifiers with `niri msg outputs` on first Niri login.
output "eDP-1" {
    position x=0 y=0
    scale 1
}
// Connector numbers change when the dock is hot-plugged. Match external
// displays by their stable Niri output names instead.
output "LG Electronics MP59G 0x00039D20" {
    position x=3840 y=0
}
output "LG Electronics MP59G 0x00039DC2" {
    position x=1920 y=0
}

// Workspaces are deliberately left dynamic. Niri keeps them local to an
// output and removes vacant ones in the middle, so disconnecting monitors
// compacts the remaining workspaces instead of leaving 1, 3, 5 gaps.
