// Verify identifiers with `niri msg outputs` on first Niri login.
output "eDP-1" {
    position x=0 y=0
    scale 1
}
output "DP-3" {
    position x=1920 y=0
}
output "DP-4" {
    position x=3840 y=0
}

// Workspaces are deliberately left dynamic. Niri keeps them local to an
// output and removes vacant ones in the middle, so disconnecting monitors
// compacts the remaining workspaces instead of leaving 1, 3, 5 gaps.
