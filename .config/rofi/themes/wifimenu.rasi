/*****----- Configuration -----*****/
configuration {
    show-icons:                 true;
    drun-display-format:        "{name}";
    window-format:              "{w} · {c} · {t}";
}

/*****----- Global Properties -----*****/
* {
    font:                        "JetBrains Mono Nerd Font 12";
    background:                  #1a1b26;
    background-alt:              #24283b;
    foreground:                  #c0caf5;
    selected:                    #414868;
    active:                      #7aa2f7;
    urgent:                      #f7768e;
    border-color:                #7aa2f7;
}

/*****----- Main Window -----*****/
window {
    transparency:                "real";
    location:                    center;
    anchor:                      center;
    fullscreen:                  false;
    width:                       500px;
    x-offset:                    0px;
    y-offset:                    0px;
    padding:                     0px;
    border:                      2px solid;
    border-radius:               15px;
    border-color:                @border-color;
    background-color:            @background;
    cursor:                      "default";
    border-color:                @active;
    background-image:            linear-gradient(to bottom, #1a1b26, #24283b);
}

/*****----- Main Box -----*****/
mainbox {
    enabled:                     true;
    spacing:                     0px;
    margin:                      0px;
    padding:                     25px;
    background-color:            transparent;
    orientation:                 vertical;
    children:                    [ "inputbar", "listview" ];
}

/*****----- Inputbar -----*****/
inputbar {
    enabled:                     true;
    spacing:                     10px;
    padding:                     15px;
    border-radius:               12px;
    background-color:            @background-alt;
    text-color:                  @foreground;
    orientation:                 horizontal;
    children:                    [ "textbox-prompt-colon", "entry"];
    margin:                      0px 0px 20px 0px;
    box-shadow:                  0px 2px 5px 0px;
}

textbox-prompt-colon {
    enabled:                     true;
    expand:                      false;
    str:                         "󰖩";  /* WiFi icon */
    padding:                     12px 15px;
    border-radius:               10px;
    background-color:            @active;
    text-color:                  @background;
    font:                        "JetBrains Mono Nerd Font 16";
}

entry {
    enabled:                     true;
    expand:                      true;
    padding:                     12px 16px;
    border-radius:               10px;
    background-color:            @background-alt;
    text-color:                  @foreground;
    cursor:                      text;
    placeholder:                 "Search WiFi network...";
    placeholder-color:           #565f89;
    font:                        "JetBrains Mono Nerd Font 12";
}

/*****----- Listview -----*****/
listview {
    enabled:                     true;
    columns:                     1;
    lines:                       6;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                true;
    fixed-columns:               true;
    spacing:                     10px;
    margin:                      0px;
    padding:                     0px;
    background-color:            transparent;
    cursor:                      "default";
}

/*****----- Elements -----*****/
element {
    enabled:                     true;
    padding:                     15px;
    border-radius:               10px;
    background-color:            @background-alt;
    text-color:                  @foreground;
    cursor:                      pointer;
}

element normal.normal {
    background-color:            @background-alt;
    text-color:                  @foreground;
}

element selected.normal {
    background-color:            @background-alt;
    text-color:                  @foreground;
}

element-icon {
    background-color:            transparent;
    text-color:                  inherit;
    size:                        24px;
    cursor:                      inherit;
    padding:                     0px 10px 0px 0px;
}

element-text {
    background-color:            transparent;
    text-color:                  inherit;
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0.0;
    font:                        "JetBrains Mono Nerd Font 11";
}

/*****----- Message -----*****/
message {
    enabled:                     true;
    margin:                      0px 0px 15px 0px;
    padding:                     15px;
    border-radius:               12px;
    background-color:            @background-alt;
    text-color:                  @foreground;
    box-shadow:                  0px 2px 5px 0px;
}

textbox {
    background-color:            inherit;
    text-color:                  inherit;
    vertical-align:              0.5;
    horizontal-align:            0.5;
    font:                        "JetBrains Mono Nerd Font 11";
}
